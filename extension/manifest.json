{
  "manifest_version": 3,
  "name": "KILLASNAZZ Operator Helper",
  "version": "1.0.0",
  "description": "AI-помощник оператора: ответы, цели и предложения доната в боковой панели.",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://operhelper.killasnazz.workers.dev/*",
    "https://*.chaturbate.com/*",
    "https://*.stripchat.com/*",
    "https://*.bongacams.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Открыть KILLASNAZZ"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://operhelper.killasnazz.workers.dev/*",
        "https://*.chaturbate.com/*",
        "https://*.stripchat.com/*",
        "https://*.bongacams.com/*"
      ],
      "js": [
        "shared/site-adapters.js",
        "content/content-script.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'self'"
  }
}
