{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "operhelper",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./src",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  }
}
